# =================================================================
# Studiolo 智学 — 企业版私有化部署配置 (v1.0.0)
# =================================================================
# [配置说明]
# 1. 请将此文件重命名为 .env 后再修改：cp env.example .env
# 2. 标记为 [必填] 的项必须改，否则无法启动、无法激活或存在安全风险。
# 3. 标记为 [勿动] 的项请保持默认，除非您清楚自己在做什么。
# =================================================================

# -----------------------------------------------------------------
# 1. 基础环境配置 (System Basic)
# -----------------------------------------------------------------
# [勿动] 运行模式: production（生产模式会关闭 Swagger 文档，保障安全）
ENVIRONMENT=production

# [勿动] 调试日志: False（关闭 SQL 回显与请求体日志，防止敏感信息泄露）
DEBUG=False

# [必填] 授权缓存加密密钥（每个部署实例独立，严禁多客户复用同一值）
# 生成命令: openssl rand -hex 32
# ⚠️ 留空或不填将导致系统无法完成授权激活——更严重的是：即使上传 .lic 显示"激活成功"，
#    授权缓存仍建不起来，登录会一直返回「需要激活」，系统实际不可用。
LICENSE_HMAC_KEY=

# [选填] 项目名称（显示在页面标题、邮件通知与日志中）
PROJECT_NAME="Studiolo"

# [重要] 跨域白名单 (CORS)
# 作用: 限制哪些域名的前端可以调用后端 API
# 默认: "*"（允许所有，方便初次部署调试）
# 生产建议: 改为前端实际访问地址，多个用逗号分隔
# 示例: "http://192.168.1.100:3001,https://studiolo.corp.com"
ALLOWED_ORIGINS=*

# [重要] 允许访问的主机头 (Trusted Hosts)
# 作用: 防止 HTTP Host 头攻击
# 默认: "*"（允许所有）
# 生产建议: 改为后端服务器的实际 IP 或域名
# 示例: "192.168.1.100,studiolo.corp.com"
# 说明: 127.0.0.1 / localhost 由 docker-compose 自动补上（容器内健康探针要用），无需自己写
ALLOWED_HOSTS=*

# -----------------------------------------------------------------
# 2. 数据库与中间件安全配置 (Security)
# 注意：系统会自动根据下方填写的密码与库名组装连接串，无需手动配置 URL
# -----------------------------------------------------------------

# [必填] Postgres 数据库密码（请设置复杂强密码）
POSTGRES_PASSWORD=ChangeMeStrongPass

# [选填] 数据库用户名（默认: studiolo）
POSTGRES_USER=studiolo

# [选填] 数据库库名（默认: studiolo_db）
# ⚠️ 仅可在全新部署时自定义；已有数据时改库名会让后端连上空的库，
#    须先清空 data/postgres/ 再启动（会删除全部业务数据）。
POSTGRES_DB=studiolo_db

# [必填] Redis 缓存数据库密码
REDIS_PASSWORD=ChangeMeRedisPass

# [必填] MinIO 对象存储密码（至少 8 位字符）
MINIO_ROOT_PASSWORD=MinioStrongPass

# [选填] MinIO 用户名（默认: minioadmin）
MINIO_ROOT_USER=minioadmin

# -----------------------------------------------------------------
# 3. 知识图谱 (Neo4j)
# 实体/关系抽取、社区检测与全局综述依赖它；compose 已内置该服务。
# -----------------------------------------------------------------

# [必填] Neo4j 密码（必须与 docker-compose 的 NEO4J_AUTH=neo4j/${NEO4J_PASSWORD} 一致）
NEO4J_PASSWORD=ChangeMeNeo4jPass

# [选填] Neo4j 用户名（默认: neo4j）
NEO4J_USER=neo4j

# [选填] Neo4j 数据库名（默认: neo4j）
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------
# 4. 邮件通知服务 (Email Service)
# 用于发送登录验证码、系统通知——不配置将无法登录系统
# -----------------------------------------------------------------

# [必填] 发件人邮箱账号（例如: service@company.com）
MAIL_USERNAME=service@yourcompany.com

# [必填] 邮箱授权码/密码（注意：通常是 SMTP 授权码，不是登录密码）
MAIL_PASSWORD=YourEmailPassword

# [必填] 发件人地址（通常与用户名一致）
MAIL_FROM=service@yourcompany.com

# [选填] SMTP 服务器地址（默认 126 邮箱；如用 QQ 邮箱请改为 smtp.qq.com）
MAIL_SERVER=smtp.126.com

# [选填] SMTP 端口（SSL 通常为 465，TLS 通常为 587）
MAIL_PORT=465

# -----------------------------------------------------------------
# 5. 访问地址 (Public URL)
# -----------------------------------------------------------------

# [必改] 后端对外访问地址（浏览器里能打开的地址）
# 系统用它拼附件与图片的下载地址；保持 localhost 会让客户自己的电脑去请求它，
# 页面上的图片/附件全部打不开。
# 生产环境: http://<服务器IP>:8001 或 https://api.yourdomain.com
BACKEND_PUBLIC_URL=http://localhost:8001
